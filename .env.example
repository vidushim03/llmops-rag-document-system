# Copy this file to .env and fill in your own keys.
# NEVER commit real keys in .env — it is gitignored.

# Required: get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: chat model used for answers (default openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: cap local Tesseract OCR pages; 0 means all PDF pages (default 0)
MAX_OCR_PAGES=0

# Optional: cap paid Groq OCR fallback pages (default 5)
MAX_GROQ_OCR_PAGES=5

# Optional: vision model used for Groq OCR
GROQ_OCR_MODEL=qwen/qwen3.8-27b

# Qdrant storage. Leave QDRANT_URL blank to use local on-disk storage.
QDRANT_PATH=knowledge_base
QDRANT_URL=
QDRANT_API_KEY=

# Optional local OCR path on Windows; Tesseract is auto-detected in common locations
TESSERACT_CMD=
