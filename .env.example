# Copy this file to .env and fill in your own keys.
# NEVER commit real keys in .env — it is gitignored.

# Required: get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: chat model used for answers (default openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: limit pages processed by OCR (default 5)
MAX_OCR_PAGES=5

# Optional: vision model used for Groq OCR (default llama-3.2-11b-vision-preview)
GROQ_OCR_MODEL=llama-3.2-11b-vision-preview

# Qdrant storage. Leave QDRANT_URL blank to use local on-disk storage.
QDRANT_PATH=knowledge_base
QDRANT_URL=
QDRANT_API_KEY=

# Optional local OCR paths on Windows (leave blank to use Groq OCR fallback)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\path\to\poppler\Library\bin
