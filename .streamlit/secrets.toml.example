# Template for Streamlit Community Cloud secrets.
# In the deploy dialog, paste this into "Advanced settings > Secrets".
# Secrets are injected as environment variables, so the app reads them with os.getenv.

# Required: get a key at https://console.groq.com
GROQ_API_KEY = "your_groq_api_key_here"

# Optional: chat model used for answers (default openai/gpt-oss-120b)
GROQ_MODEL = "openai/gpt-oss-120b"

# Optional: only needed if you also run the CLI (main.py) against a remote
# Qdrant cluster. The web app itself stores uploads in-memory per session.
# QDRANT_URL = "https://your-cluster-id.aws.cloud.qdrant.io:6333"
# QDRANT_API_KEY = "your_qdrant_api_key_here"

MAX_OCR_PAGES = "5"
GROQ_OCR_MODEL = "llama-3.2-11b-vision-preview"
